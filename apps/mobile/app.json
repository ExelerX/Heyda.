{
  "expo": {
    "name": "Heyda",
    "slug": "heyda",
    "scheme": "heyda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.exelerx.heyda",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "io.github.exelerx.heyda",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "permissions": [
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Heyda.",
      "shortName": "Heyda.",
      "lang": "de",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "./plugins/with-display-name",
        {
          "displayName": "Heyda."
        }
      ],
      "./plugins/with-release-signing",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Damit deine Freunde ungefähr wissen, wann du ankommst. Dein genauer Standort bleibt auf deinem Handy.",
          "locationAlwaysAndWhenInUsePermission": "Damit „Gleich da“ und Ankunfts-Hinweise auch funktionieren, wenn die App geschlossen ist. Dein genauer Standort bleibt auf deinem Handy.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nur zum Scannen des QR-Codes, wenn du jemanden hinzufügst.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "./plugins/with-local-notifications-only",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
